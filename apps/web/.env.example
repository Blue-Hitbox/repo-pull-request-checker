# AI Code Reviewer Dashboard

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ai_reviewer?schema=public"

# Secret used to encrypt user API keys at rest (Long random string)
ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_STRING

# Secret used to authorize the Bot's requests to the Dashboard
DASHBOARD_API_SECRET=CHANGE_ME_TO_RANDOM_STRING
