generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  githubId  Int      @unique
  username  String
  createdAt DateTime @default(now())
  apiKeys   ApiKey[]

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  keyHash    String    // Hashed for verification
  encryptedKey String  // Encrypted for retrieval by the bot
  keyPrefix  String    // e.g. "sk-..." for display
  label      String?
  createdAt  DateTime  @default(now())
  lastUsed   DateTime?
  expiresAt  DateTime?

  @@unique([userId, provider])
  @@map("api_keys")
}
