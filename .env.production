# ===========================================
# Production Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!

# ------------------------------------------
# Database
# ------------------------------------------
POSTGRES_USER=ai_reviewer
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=ai_reviewer

# ------------------------------------------
# Web Application
# ------------------------------------------
# The public URL of your dashboard (used for CORS and cookies)
# Example: https://reviewer.yourdomain.com
ORIGIN=https://reviewer.yourdomain.com

# Port the web app listens on inside the container
WEB_PORT=3000

# ------------------------------------------
# Security (generate with: openssl rand -hex 32)
# ------------------------------------------
# Master key for encrypting user API keys at rest (AES-256)
ENCRYPTION_KEY=GENERATE_A_64_CHAR_HEX_STRING

# Shared secret for authorizing CLI/bot requests to the dashboard
DASHBOARD_API_SECRET=GENERATE_ANOTHER_64_CHAR_HEX_STRING

# ------------------------------------------
# Optional: Fallback AI Provider Settings
# ------------------------------------------
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
